# ---------------------------------------------------------------------------
# Sovereign AI — frontend environment configuration
#
# Copy to `.env.local` (git-ignored) if you need to override anything.
#
# SECURITY: this file must NEVER contain API keys, model secrets, database
# passwords, HF tokens or provider credentials. Everything in a VITE_* variable is
# compiled into the JavaScript bundle and is therefore public to the browser.
# The browser only ever talks to the LOCAL backend; the backend holds no external
# credentials either (there are no external providers).
# ---------------------------------------------------------------------------

# Base URL of the local Sovereign AI FastAPI backend.
#   "/api"                      -> same-origin, proxied by Vite to the backend
#                                  (see `server.proxy` / `preview.proxy` in
#                                  vite.config.ts). No CORS involved. RECOMMENDED.
#   "http://localhost:8000/api" -> direct call to the backend (requires the origin
#                                  to be listed in the backend CORS_ALLOW_ORIGINS).
VITE_API_BASE_URL=/api

# Where the backend is reached by the Vite dev/preview proxy.
VITE_BACKEND_ORIGIN=http://localhost:8000

# Request timeout (ms) for short control-plane calls (health, models, artifacts).
VITE_API_TIMEOUT_MS=30000

# Request timeout (ms) for local inference calls. CPU-only llama.cpp inference on a
# 3B Q4 model is slow: a coding run with sandbox verification can take >10 minutes.
VITE_INFERENCE_TIMEOUT_MS=2400000
