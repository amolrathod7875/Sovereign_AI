# -----------------------------
# Models (large binaries, do not commit)
# -----------------------------
models/
PID_Dataset/
data/
*.gguf

# Model cache (huggingface / download cache)
.cache/
**/.cache/

# -----------------------------
# Python-generated files
# -----------------------------
__pycache__/
**/__pycache__/
*.py[oc]
*.pyc
*.egg-info/
.pytest_cache/

# -----------------------------
# Secrets — never commit local env files
# -----------------------------
.env
.env.local
.env.*
!.env.example
uploads/
