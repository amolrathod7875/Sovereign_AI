# Environment variables for Sovereign AI
APP_ENV=local
SOVEREIGN_MODE=true

# PostgreSQL
POSTGRES_URL=postgresql://postgres:postgres@postgres:5432/sovereign_ai

# Qdrant Vector Database
QDRANT_URL=http://qdrant:6333

# vLLM Model Endpoints
VLLM_GENERAL_URL=http://vllm-general:8000/v1
VLLM_CODER_URL=http://vllm-coder:8000/v1
VLLM_VISION_URL=http://vllm-vision:8000/v1

# Embedding and Reranker Models
EMBEDDING_MODEL=/models/embedding
RERANKER_MODEL=/models/reranker

# Piston Sandbox
PISTON_URL=http://piston:2000

# Storage
ARTIFACT_DIR=/data/artifacts
UPLOAD_DIR=/data/uploads

# Limits
MAX_FILE_MB=50
SANDBOX_TIMEOUT_SECONDS=10
MAX_OUTPUT_KB=256
