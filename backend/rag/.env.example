# Phase 3 - Local hybrid RAG configuration (Sovereign AI)
# All values are consumed by backend/rag/config.py. Copy to .env and adjust.
# Everything runs locally: no cloud APIs, no external embedding, no network calls.

# Local embedding model (sentence-transformers, loaded from local HF cache, offline)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Dedicated Qdrant collection for the Sovereign AI knowledge base (local embedded mode)
QDRANT_COLLECTION=sovereign_knowledge

# Hybrid fusion weights (must sum to 1.0; configurable, not hard-coded)
SEMANTIC_WEIGHT=0.7
BM25_WEIGHT=0.3

# Chunking behaviour
MAX_CHUNK_CHARS=1200
MIN_CHUNK_CHARS=80

# Force fully-offline model loading (zero network)
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
